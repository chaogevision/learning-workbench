# 服务监听
HOST=127.0.0.1
PORT=4173

# mock：服务端返回本地演示数据，不需要密钥
# compatible：调用 OpenAI-compatible Chat Completions 接口
API_MODE=mock

# 仅 API_MODE=compatible 时填写。密钥只放在服务端 .env，绝不能写进前端 config.js。
AI_API_BASE_URL=https://your-provider.example/v1
AI_API_PATH=/chat/completions
AI_API_KEY=replace_with_server_side_key
AI_MODEL=replace_with_lightweight_model
AI_JSON_MODE=auto
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=3600
AI_TIMEOUT_MS=40000

# 可选：跨域部署时使用；同源部署请留空。多个来源用英文逗号分隔。
CORS_ORIGIN=
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=1000000
